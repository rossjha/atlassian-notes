# Copy to ~/.config/atlassian-notes/.env (or run `npm run setup`)
JIRA_BASE_URL=https://your-site.atlassian.net
# Optional: required for scoped API tokens
JIRA_CLOUD_ID=
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=
JIRA_PROJECT=KEY
# NOTES_DIR=~/atlassian-notes-data
# REFRESH_MINUTES=15
# PORT=4317
# HOST=127.0.0.1
# OPEN_BROWSER=true
