{
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "public/js",
    "target": "es2023",
    "lib": ["dom", "es2023"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "rewriteRelativeImportExtensions": true,
    "strict": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": []
  },
  "include": ["src/web", "src/shared"]
}
